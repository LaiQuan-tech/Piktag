# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts — NEVER commit (public repo; bundles inline keys)
dist/

# Python build artifacts
__pycache__/
*.pyc
supabase/.temp/

# 只有 root 那條 supabase/.temp/ 蓋不到 mobile/ 底下（2026-11-18 補）
**/supabase/.temp/

# Apple / Google 簽章與服務帳號（公開 repo，2026-11-18 補）
*.p8
*.p12
*.mobileprovision
google-play-service-account.json
*service-account*.json
